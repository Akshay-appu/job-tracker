# Spring Boot backend base URL (used by Vite dev proxy and the axios baseURL fallback).
# In dev, requests to /api/* are proxied here.
VITE_BACKEND_URL=http://localhost:8080

# Optional: set explicit API base. If unset, we use "/api" so the Vite proxy handles it.
# VITE_API_BASE_URL=http://localhost:8080/api
